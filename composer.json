{
    "name": "coolms/theme-default",
    "description": "Default Bootstrap 5 + DTMPL SSR theme for CoolMS 2.0",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "CoolMS Team"
        }
    ],
    "require": {
        "php": ">=8.5",
        "coolms/core": "^2.0",
        "coolms/theme-bootstrap": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\ThemeDefault\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "id": "coolms/theme-default",
            "allow-contrib": false
        }
    }
}
