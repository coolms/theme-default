{
    "name": "coolms/theme-default",
    "description": "The default CoolMS theme: Bootstrap styling over server-rendered DTMPL templates",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "CoolMS Team"
        }
    ],
    "require": {
        "php": ">=8.5",
        "coolms/core": "^2.0",
        "coolms/theme-bootstrap": "^2.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-kernel": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\ThemeDefault\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "id": "coolms/theme-default",
            "allow-contrib": false
        },
        "branch-alias": {
            "dev-develop": "2.0.x-dev"
        }
    }
}
