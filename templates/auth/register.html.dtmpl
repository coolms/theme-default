{include:`layouts/auth.html.dtmpl`}
  {fill:content}
    <h1 class="h4 mb-4">Create account</h1>

    {loop:flashes.error}
      <div class="alert alert-danger">{var:item.message}</div>
    {endloop}

    {widget:form:`identity.register`}

    {if:routes.login}
      <p class="mt-3 text-center text-muted small">
        Already have an account? <a href="{var:routes.login}">Sign in</a>
      </p>
    {endif}
  {endfill}
{endinclude}
