{include:`layouts/auth.html.dtmpl`}
  {fill:content}
    <h1 class="h4 mb-4">Reset your password</h1>

    {loop:flashes.error}
      <div class="alert alert-danger">{var:item.message}</div>
    {endloop}
    {loop:flashes.success}
      <div class="alert alert-success">{var:item.message}</div>
    {endloop}

    {unless:flashes.success}
      {comment}
        The FORM is the Identity module's definition
        (`config/modules/identity/forms/password-reset-confirm.yaml`); this page
        is the chrome around it. The code field takes the mailed `?token=`
        through the definition's `prefill_from_query`, so the prefill cannot be
        in one theme and missing in another -- which is exactly what happened
        between 09-17 and 09-22.
      {endcomment}
      {widget:form:`identity.password_reset_confirm`}
    {endunless}

    <p class="mt-3 text-center">
      <a href="{var:routes.login}">Back to login</a>
    </p>
  {endfill}
{endinclude}
