{include:`layouts/auth.html.dtmpl`}
  {fill:content}
    <h1 class="h4 mb-4">Forgot password</h1>

    {loop:flashes.error}
      <div class="alert alert-danger">{var:item.message}</div>
    {endloop}
    {loop:flashes.success}
      <div class="alert alert-success">{var:item.message}</div>
    {endloop}

    {unless:flashes.success}
      {comment}
        The FORM is the Identity module's definition; this page is the chrome
        around it. The fields, the action, the CSRF id and the validation
        live in `config/modules/identity/forms/password-reset-request.yaml`, as
        login and register have always done -- so a change to what the server
        reads cannot leave one theme behind.
      {endcomment}
      {widget:form:`identity.password_reset_request`}
    {endunless}

    <p class="mt-3 text-center">
      <a href="{var:routes.login}">Back to login</a>
    </p>
  {endfill}
{endinclude}
