{include:`layouts/auth.html.dtmpl`}
  {fill:content}
    <h1 class="h4 mb-4">You are invited</h1>

    {loop:flashes.error}
      <div class="alert alert-danger">{var:item.message}</div>
    {endloop}
    {loop:flashes.success}
      <div class="alert alert-success">{var:item.message}</div>
    {endloop}

    {unless:flashes.success}
      {if:request.query.token}
        <p class="text-muted">An account has been prepared for you. Choose a password to take it.</p>
        {comment}The token from the mailed link is the credential: it works once and expires. No CSRF token: a forged post could only spend a token the attacker already holds.{endcomment}
        <form action="/auth/invitation/accept" method="POST">
          <input type="hidden" name="token" value="{var:request.query.token escape}">
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password"
                   required autocomplete="new-password" minlength="8">
          </div>
          <button type="submit" class="btn btn-primary w-100">Set password and sign in</button>
        </form>
      {else}
        <div class="alert alert-warning">This page is opened from the link in an invitation mail. Open the link, or ask to be invited again.</div>
      {endif}
    {endunless}

    <p class="mt-3 text-center">
      <a href="{var:routes.login}">Go to login</a>
    </p>
  {endfill}
{endinclude}
