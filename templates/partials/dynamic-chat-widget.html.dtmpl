{verbatim}<style>
/* Bottom offset clears the cookie banner while it is up (it publishes its own
   height) and collapses to the plain margin once a visitor has answered. */
.coolms-lc{position:fixed;right:18px;bottom:calc(18px + var(--coolms-consent-height, 0px));z-index:1090;font-family:inherit;transition:bottom .2s ease}
.coolms-lc__launcher{display:inline-flex;align-items:center;gap:.5rem;border:0;border-radius:999px;background:#2563eb;color:#fff;padding:.7rem 1.1rem;font:inherit;font-size:.95rem;line-height:1;cursor:pointer;box-shadow:0 6px 20px rgba(37,99,235,.35)}
.coolms-lc__launcher:hover{background:#1d4ed8}
.coolms-lc__launcher svg{width:18px;height:18px;fill:currentColor}
.coolms-lc__panel{display:none;flex-direction:column;width:340px;max-width:calc(100vw - 36px);height:460px;max-height:calc(100vh - 36px);background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,.18)}
.coolms-lc[data-open="1"] .coolms-lc__panel{display:flex}
.coolms-lc[data-open="1"] .coolms-lc__launcher{display:none}
.coolms-lc__head{display:flex;align-items:center;justify-content:space-between;background:#2563eb;color:#fff;padding:.7rem .9rem;flex-shrink:0}
.coolms-lc__title{margin:0;font-size:.95rem;font-weight:600}
.coolms-lc__close{border:0;background:transparent;color:#fff;font-size:1.3rem;line-height:1;cursor:pointer;padding:0 .25rem}
.coolms-lc__body{flex:1 1 auto;overflow-y:auto;padding:.85rem;background:#f9fafb}
.coolms-lc__msgs{display:flex;flex-direction:column;gap:.4rem}
.coolms-lc__msg{max-width:80%;padding:.45rem .7rem;border-radius:12px;font-size:.88rem;line-height:1.35;word-wrap:break-word}
.coolms-lc__msg--them{align-self:flex-start;background:#fff;border:1px solid #e5e7eb;color:#111827;border-bottom-left-radius:3px}
.coolms-lc__msg--me{align-self:flex-end;background:#2563eb;color:#fff;border-bottom-right-radius:3px}
.coolms-lc__msg--sys{align-self:center;background:transparent;color:#6b7280;font-size:.78rem;font-style:italic}
.coolms-lc__form{padding:.85rem;display:flex;flex-direction:column;gap:.5rem;overflow-y:auto}
.coolms-lc__form p{margin:0 0 .15rem;font-size:.85rem;color:#374151}
.coolms-lc__input{width:100%;border:1px solid #d1d5db;border-radius:8px;padding:.5rem .65rem;font:inherit;font-size:.88rem;box-sizing:border-box}
.coolms-lc__input:focus{outline:2px solid #93c5fd;outline-offset:-1px;border-color:#2563eb}
.coolms-lc__textarea{resize:vertical;min-height:4.5rem;font-family:inherit;line-height:1.4}
.coolms-lc__fields{display:flex;flex-direction:column;gap:.5rem}
.coolms-lc__phone{display:flex;gap:.4rem}
.coolms-lc__country{flex:0 0 auto;max-width:46%;border:1px solid #d1d5db;border-radius:8px;padding:.5rem .4rem;font:inherit;font-size:.82rem;background:#fff;box-sizing:border-box}
.coolms-lc__country:focus{outline:2px solid #93c5fd;outline-offset:-1px;border-color:#2563eb}
.coolms-lc__phone .coolms-lc__input{flex:1 1 auto;min-width:0}
.coolms-lc__foot{display:flex;flex-direction:column;gap:.4rem;padding:.6rem;border-top:1px solid #e5e7eb;background:#fff;flex-shrink:0}
.coolms-lc__inrow{display:flex;gap:.4rem;align-items:center}
.coolms-lc__send{border:0;border-radius:8px;background:#2563eb;color:#fff;padding:.5rem .9rem;font:inherit;font-size:.88rem;cursor:pointer}
.coolms-lc__send:hover{background:#1d4ed8}
.coolms-lc__send:disabled{background:#9ca3af;cursor:default}
.coolms-lc__attach{flex:0 0 auto;border:0;border-radius:8px;background:#eef2ff;color:#2563eb;padding:.45rem .55rem;font-size:1rem;line-height:1;cursor:pointer}
.coolms-lc__attach:hover{background:#e0e7ff}
.coolms-lc__pending{display:flex;flex-wrap:wrap;gap:.3rem}
.coolms-lc__chip{display:inline-flex;align-items:center;gap:.25rem;background:#eef2ff;color:#3730a3;border-radius:999px;padding:.2rem .5rem;font-size:.78rem;max-width:100%;word-break:break-all}
.coolms-lc__chip--up{background:#f3f4f6;color:#6b7280;font-style:italic}
.coolms-lc__chipx{border:0;background:transparent;color:inherit;font-size:.95rem;line-height:1;cursor:pointer;padding:0}
.coolms-lc__txt{white-space:pre-wrap}
.coolms-lc__atts{display:flex;flex-direction:column;gap:.35rem;margin-top:.35rem}
.coolms-lc__thumb{max-width:180px;max-height:180px;border-radius:8px;display:block}
.coolms-lc__file{display:inline-flex;align-items:center;gap:.3rem;border:1px solid #d1d5db;background:#fff;color:#2563eb;border-radius:8px;padding:.3rem .55rem;font:inherit;font-size:.8rem;cursor:pointer;text-align:left;max-width:100%;word-break:break-all}
.coolms-lc__file--me{border-color:rgba(255,255,255,.5);background:rgba(255,255,255,.15);color:#fff}
.coolms-lc__file:hover{filter:brightness(.97)}
.coolms-lc__btn{border:0;border-radius:8px;background:#2563eb;color:#fff;padding:.55rem .9rem;font:inherit;font-size:.9rem;cursor:pointer}
.coolms-lc__btn:hover{background:#1d4ed8}
.coolms-lc__btn:disabled{background:#9ca3af;cursor:default}
.coolms-lc__err{color:#b91c1c;font-size:.8rem;margin:.1rem 0 0}
.coolms-lc [hidden]{display:none!important}
</style>
<div class="coolms-lc" id="coolms-lc" data-open="0" aria-live="polite">
  <button type="button" class="coolms-lc__launcher" data-lc="open" aria-label="Open chat">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C6.5 3 2 6.8 2 11.5c0 2.2 1 4.2 2.7 5.7-.1 1.2-.5 2.6-1.4 3.6-.2.2-.1.6.2.6 1.9 0 3.4-.8 4.4-1.6 1.2.4 2.6.7 4.1.7 5.5 0 10-3.8 10-8.5S17.5 3 12 3z"/></svg>
    <span>Chat with us</span>
  </button>
  <div class="coolms-lc__panel" role="dialog" aria-label="Live chat">
    <div class="coolms-lc__head">
      <p class="coolms-lc__title">Chat with us</p>
      <button type="button" class="coolms-lc__close" data-lc="close" aria-label="Close chat">&times;</button>
    </div>
    <form class="coolms-lc__form" data-lc="prechat" hidden>
      <p>Hi! Leave your details and a message — we'll get right back to you.</p>
      <!-- Filled from the form definition (GET /config -> items). The fields a
           visitor sees, their types, their order and their words are declared
           on the server; this is the surface that draws them. The fallback
           markup below is used only when an older server sends no items. -->
      <div class="coolms-lc__fields" data-lc="fields"></div>
      <template data-lc="fallback-fields">
        <input class="coolms-lc__input" data-lc="f-name" type="text" placeholder="Your name" autocomplete="name">
        <input class="coolms-lc__input" data-lc="f-email" type="email" placeholder="Your email" autocomplete="email">
        <div class="coolms-lc__phone" data-lc="phone-group" hidden>
          <select class="coolms-lc__country" data-lc="country" aria-label="Country"></select>
          <input class="coolms-lc__input" data-lc="f-phone" type="tel" inputmode="tel" placeholder="Phone" autocomplete="tel">
        </div>
        <textarea class="coolms-lc__input coolms-lc__textarea" data-lc="f-message" rows="3"
                  placeholder="How can we help?"></textarea>
      </template>
      <button type="submit" class="coolms-lc__btn" data-lc="start">Start chat</button>
      <p class="coolms-lc__err" data-lc="prechat-err" hidden></p>
    </form>
    <div class="coolms-lc__body" data-lc="body" hidden>
      <div class="coolms-lc__msgs" data-lc="msgs"></div>
    </div>
    <form class="coolms-lc__foot" data-lc="composer" hidden>
      <div class="coolms-lc__pending" data-lc="pending" hidden></div>
      <p class="coolms-lc__err" data-lc="composer-err" hidden></p>
      <div class="coolms-lc__inrow">
        <button type="button" class="coolms-lc__attach" data-lc="attach" aria-label="Attach a file" title="Attach a file">📎</button>
        <input class="coolms-lc__file-input" data-lc="file" type="file" multiple hidden>
        <input class="coolms-lc__input" data-lc="text" type="text" placeholder="Type a message…" autocomplete="off">
        <button type="submit" class="coolms-lc__send" data-lc="send">Send</button>
      </div>
    </form>
  </div>
</div>
{endverbatim}<script src="/site-scripts/chat-widget.js"></script>
