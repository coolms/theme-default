<title>{var:seo.title default=`CoolMS`}</title>
<meta name="description" content="{var:seo.description}">
{if:seo.canonical}<link rel="canonical" href="{var:seo.canonical}">{endif}
{if:seo.noindex}<meta name="robots" content="noindex, nofollow">{endif}
<meta property="og:title" content="{var:seo.ogTitle default=`CoolMS`}">
<meta property="og:description" content="{var:seo.ogDescription}">
<meta property="og:type" content="{var:seo.ogType default=`website`}">
{if:seo.canonical}<meta property="og:url" content="{var:seo.canonical}">{endif}
{if:seo.ogImage}<meta property="og:image" content="{var:seo.ogImage}">{endif}
<meta name="twitter:card" content="{var:seo.twitterCard default=`summary`}">
{if:seo.jsonLd}<script type="application/ld+json">{var:seo.jsonLd raw}</script>{endif}
