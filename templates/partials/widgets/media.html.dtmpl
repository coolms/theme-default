{if:kind=`image`}{if:caption}<figure>{endif}<img src="{var:url escape}" alt="{var:alt escape}" loading="lazy" style="object-position:{var:focal escape}"{if:width} width="{var:width}"{endif}{if:height} height="{var:height}"{endif}{if:class} class="{var:class escape}"{endif}>{if:caption}<figcaption>{var:caption escape}</figcaption></figure>{endif}{endif}
{if:kind=`video`}{if:caption}<figure>{endif}<video src="{var:url escape}"{if:poster} poster="{var:poster escape}"{endif}{if:width} width="{var:width}"{endif}{if:height} height="{var:height}"{endif}{if:class} class="{var:class escape}"{endif} controls></video>{if:caption}<figcaption>{var:caption escape}</figcaption></figure>{endif}{endif}
{if:kind=`audio`}{if:caption}<figure>{endif}<audio src="{var:url escape}"{if:class} class="{var:class escape}"{endif} controls></audio>{if:caption}<figcaption>{var:caption escape}</figcaption></figure>{endif}{endif}
{if:kind=`download`}<a href="{var:url escape}" download>&#128206; {var:filename escape}</a>{endif}
{if:kind=`grid`}<div class="{var:class escape}" style="--cols:{var:cols}">{loop:items:it}<div class="media-gallery-item"><img src="{var:it.url escape}" alt="{var:it.alt escape}" loading="lazy" style="object-position:{var:it.focal escape}"></div>{endloop}</div>{endif}
{if:kind=`slider`}<div class="{var:class escape}" id="{var:id escape}">{loop:items:it}<div class="media-slide"><img src="{var:it.url escape}" alt="{var:it.alt escape}" loading="lazy" style="object-position:{var:it.focal escape}"></div>{endloop}</div>{endif}
{if:kind=`list`}<ul class="{var:class escape}">{loop:items:it}<li class="media-list-item"><img src="{var:it.url escape}" alt="{var:it.alt escape}" loading="lazy"> <span>{var:it.alt escape}</span></li>{endloop}</ul>{endif}
