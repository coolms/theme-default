{verbatim}<style>.coolms-imagemap{position:relative;display:block;max-width:100%}.coolms-imagemap>img{display:block;width:100%;height:auto}.coolms-imagemap>svg{position:absolute;inset:0;width:100%;height:100%}</style>{endverbatim}<div class="coolms-imagemap{if:class} {var:class escape}{endif}"><img src="{var:imageUrl escape}" alt="{var:title escape}" loading="lazy">{var:overlaySvg raw}</div>
