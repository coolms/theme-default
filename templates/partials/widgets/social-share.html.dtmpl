<div class="social-share" aria-label="Share this page">
  <span class="social-share__label">{var:label escape}</span>
  {loop:items:it}<a class="social-share__link social-share__link--{var:it.key escape}" href="{var:it.href escape}" target="_blank" rel="noopener noreferrer" title="Share on {var:it.label escape}"><i class="bi bi-{var:it.icon escape}" aria-hidden="true"></i><span>{var:it.label escape}</span></a>{endloop}
  <button type="button" class="social-share__link social-share__link--copy" data-share-url="{var:url escape}" title="Copy link"><i class="bi bi-link-45deg" aria-hidden="true"></i><span>Copy link</span></button>
</div>
<script src="/site-scripts/social-share.js"></script>
