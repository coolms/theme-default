{comment}
  The header's language switcher: the widget draws it (partials/widgets/language-switcher.html.dtmpl), this partial
  holds its rules, since a widget's template is not on the static include walk and its {css} would be dropped.
  At phone width the summary shows the globe and the code only.
{endcomment}
{css}
.lang-switch{position:relative}
.lang-switch__current{display:inline-flex; align-items:center; gap:.375rem; padding:.25rem .5rem; border-radius:.375rem;
  cursor:pointer; list-style:none; color:inherit}
.lang-switch__current::-webkit-details-marker{display:none}
.lang-switch__current::after{content:""; border:solid currentColor; border-width:0 1px 1px 0; padding:2px;
  transform:rotate(45deg); margin:0 .125rem .2rem .25rem}
.lang-switch__menu[open] .lang-switch__current::after{transform:rotate(-135deg); margin-bottom:-.1rem}
.lang-switch__current:focus-visible,.lang-switch__link:focus-visible{outline:2px solid currentColor; outline-offset:2px}
.lang-switch__code{display:none}
.lang-switch__list{position:absolute; right:0; z-index:1000; min-width:12rem; margin:.25rem 0 0; padding:.25rem 0;
  list-style:none; background:var(--bs-body-bg, #fff); color:var(--bs-body-color, #212529);
  border:1px solid var(--bs-border-color, #dee2e6); border-radius:.375rem; box-shadow:0 .5rem 1rem rgba(0,0,0,.15)}
.lang-switch__list .lang-switch__link{display:flex; justify-content:space-between; gap:1rem; padding:.375rem .75rem;
  color:inherit; text-decoration:none}
.lang-switch__list .lang-switch__link:hover{background:var(--bs-tertiary-bg, #f8f9fa)}
.lang-switch__list .lang-switch__link[aria-current]{font-weight:600}
.lang-switch__aside{color:var(--bs-secondary-color, #6c757d); font-size:.875em}
.lang-switch--inline{display:inline-flex; align-items:center; gap:.5rem}
.lang-switch--inline .lang-switch__link{color:inherit; text-decoration:none; opacity:.75}
.lang-switch--inline .lang-switch__link[aria-current]{opacity:1; font-weight:600; text-decoration:underline}
@media (max-width:575.98px){
  .lang-switch__text{display:none}
  .lang-switch__code{display:inline}
}
{endcss}
{if:i18n.locales}<div class="me-2">{widget:language_switcher display=`native` icon=`on` mode=`dropdown`}</div>{endif}
