<section class="block block-gallery py-5">
  <div class="container">
    {if:block.title}<h2 class="text-center mb-4">{var:block.title escape}</h2>{endif}
    <div class="row g-3">
      {loop:block.items:img}
        <div class="col-6 col-md-4">
          {if:img.href}<a href="{var:img.href escape}">{endif}
          {if:img.src}<img class="img-fluid rounded" src="{var:img.src escape}" alt="{var:img.alt escape}">{endif}
          {if:img.href}</a>{endif}
        </div>
      {endloop}
    </div>
  </div>
</section>
