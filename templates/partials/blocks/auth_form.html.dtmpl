{comment}
  theme-default's look for the platform's `auth_form` block (Identity): the same logic, in the Bootstrap card the old
  sign-in templates had. The form is still given its id and NOTHING ELSE -- action, field names, password type and
  CSRF token stay Identity's form definition. Keep the logic in step with the platform's partial
  (src/Identity/templates/partials/blocks/auth_form.html.dtmpl); only the classes here are the theme's.
{endcomment}
<section class="block-auth-form d-flex justify-content-center py-5">
  <div class="card shadow-sm border-0 w-100" style="max-width: 400px;">
  <div class="card-body p-4">
    {if:block.eyebrow}<p class="text-uppercase text-secondary small fw-semibold mb-2">{var:block.eyebrow escape}</p>{endif}
    {if:block.heading}<h1 class="h4 mb-4">{var:block.heading escape}</h1>{endif}
    {if:block.form=`login`}
      {if:error.reason}{unless:flashes.error}<div class="alert alert-warning">Please sign in to continue.</div>{endunless}{endif}
    {endif}
    {loop:flashes.error}<div class="alert alert-danger">{var:item.message}</div>{endloop}
    {loop:flashes.success}<div class="alert alert-success">{var:item.message}</div>{endloop}
    {if:block.intro}<p class="text-body-secondary">{var:block.intro escape}</p>{endif}

    {if:block.form=`login`}{widget:form:`identity.login`}{endif}
    {if:block.form=`register`}{widget:form:`identity.register`}{endif}
    {if:block.form=`password_reset_request`}{unless:flashes.success}{widget:form:`identity.password_reset_request`}{endunless}{endif}
    {if:block.form=`password_reset_confirm`}{unless:flashes.success}{widget:form:`identity.password_reset_confirm`}{endunless}{endif}
    {if:block.form=`verify_email`}
      {unless:flashes.success}
        {widget:form:`identity.verify_email`}
        <p class="text-center text-muted small mt-3 mb-0">Nothing arrived, or the code has expired?</p>
        {widget:form:`identity.verify_email_resend`}
      {endunless}
    {endif}
    {if:block.form=`invitation_accept`}
      {unless:flashes.success}{if:request.query.token}{widget:form:`identity.invitation_accept`}{endif}{endunless}
    {endif}

    {if:block.help}<p class="text-muted small mt-3">{var:block.help escape}</p>{endif}

    {if:block.form=`login`}
      {if:routes.register}<p class="text-center text-muted small mt-3 mb-0">No account? <a href="{var:routes.register href}">Register</a></p>{endif}
      {if:routes.passwordReset}<p class="text-center text-muted small mt-3 mb-0"><a href="{var:routes.passwordReset href}">Forgot password?</a></p>{endif}
    {endif}
    {if:block.form=`register`}
      {if:routes.login}<p class="text-center text-muted small mt-3 mb-0">Already have an account? <a href="{var:routes.login href}">Sign in</a></p>{endif}
    {endif}
    {unless:block.form=`login`}{unless:block.form=`register`}
      {if:routes.login}<p class="text-center text-muted small mt-3 mb-0"><a href="{var:routes.login href}">Back to sign in</a></p>{endif}
    {endunless}{endunless}
  </div>
  </div>
</section>
