{comment}
  The mail alias confirmation page's CONTENT, drawn inside the frame: a narrow Bootstrap card around the platform's
  partials/email-alias-confirm.html.dtmpl. Chrome only -- the states, the buttons' hooks and the script are the
  partial's, included rather than copied, so this file never has to change when they do.
{endcomment}
{css}
.alias-confirm-page{max-width:32rem}
.alias-confirm h1{font-size:1.5rem; margin-bottom:1rem}
.alias-confirm__muted{color:var(--bs-secondary-color, #6c757d)}
.alias-confirm__fine{font-size:.875rem; margin:1rem 0 0}
.alias-confirm__facts{margin:0 0 1.5rem; padding:1rem; border:1px solid var(--bs-border-color, #dee2e6);
  border-radius:.5rem}
.alias-confirm__facts dt{font-size:.75rem; font-weight:500; text-transform:uppercase; letter-spacing:.04em;
  color:var(--bs-secondary-color, #6c757d)}
.alias-confirm__facts dd{margin:0 0 .75rem; font-weight:600; overflow-wrap:anywhere}
.alias-confirm__facts dd:last-child{margin-bottom:0}
.alias-confirm__facts dd .alias-confirm__muted{font-weight:400}
.alias-confirm__actions{display:flex; flex-wrap:wrap; gap:.75rem}
.alias-confirm__actions .btn{flex:1 1 9rem}
{endcss}
<div class="alias-confirm-page mx-auto py-4">
  <div class="card shadow-sm">
    <div class="card-body p-4">
      {include:`partials/email-alias-confirm.html.dtmpl`}
    </div>
  </div>
</div>
