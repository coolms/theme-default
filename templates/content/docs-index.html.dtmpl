{comment}
  The CONTENT of a documentation collection's listing, with its sidebar, drawn inside the frame (decided 2026-10-20).
  Overrides the platform's collection renderer for collections of type `docs`.
{endcomment}
<div class="docs-index py-2">
  <div class="row">
    {include:`partials/docs-sidebar.html.dtmpl`}
    <div class="docs-index__main col-lg-9">
      <h1 class="docs-index__title">{var:collection.title default=`Documentation`}</h1>
      {if:collection.hasPosts}
        <p class="docs-index__lead text-muted">{var:collection.count} article(s) in this section.</p>
        <div class="docs-index__grid row row-cols-1 row-cols-md-2 g-3 mt-1">
          {loop:docs.sidebar}
            <div class="col">
              <a class="card h-100 docs-index__card text-decoration-none" href="{var:item.url}">
                <div class="card-body">
                  <h2 class="h5 card-title mb-0">{var:item.title}</h2>
                </div>
              </a>
            </div>
          {endloop}
        </div>
      {endif}
      {if:collection.isEmpty}
        <p class="docs-index__empty text-muted mt-3">No documentation published yet.</p>
      {endif}
    </div>
  </div>
</div>
