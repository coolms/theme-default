{comment}
  The CONTENT of a plain page, drawn inside the frame (decided 2026-10-20). Overrides the platform's
  renderer of the same name.
{endcomment}
<article class="py-2">
  <h1>{var:page.title}</h1>
  <div class="page-content">
    {var:page.body raw}
  </div>
  {if:page.revisedAt}
    <p class="text-secondary small mt-4">Last updated <time datetime="{var:page.revisedAt}">{var:page.revisedAt}</time></p>
  {endif}
</article>
