{include:`layouts/default.html.dtmpl`}
  {fill:content}
    <div class="py-5 text-center">
      <h1 class="display-1 fw-bold text-muted">401</h1>
      <h2 class="h4 mb-3">Authentication required</h2>
      <p class="text-muted mb-4">Please log in to access this page.</p>
      <a href="{var:routes.login}" class="btn btn-primary">Log in</a>
      <a href="/" class="btn btn-outline-secondary ms-2">Go home</a>
    </div>
  {endfill}
{endinclude}
