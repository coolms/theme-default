<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{var:subject escape}</title>
</head>
<body style="margin:0; padding:0; background:#f5f5f7; -webkit-font-smoothing:antialiased;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f5f5f7;">
    <tr>
        <td align="center" style="padding:32px 12px;">
            <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
                   style="width:100%; max-width:600px; background:#ffffff; border-radius:10px; overflow:hidden;">

                <tr>
                    <td style="height:4px; background:#F5A623; font-size:0; line-height:0;">&nbsp;</td>
                </tr>

                {if:siteName}
                <tr>
                    <td style="padding:22px 32px 0; font:700 16px/1.3 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; color:#111827;">
                        {if:siteUrl}<a href="{var:siteUrl escape}" style="color:#111827; text-decoration:none;">{var:siteName escape}</a>{else}{var:siteName escape}{endif}
                    </td>
                </tr>
                {endif}

                <tr>
                    <td style="padding:22px 32px 30px; font:400 16px/1.65 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; color:#1f2937;">
                        {var:body raw}
                    </td>
                </tr>

                <tr>
                    <td style="padding:0 32px 26px;">
                        <hr style="border:0; border-top:1px solid #e5e7eb; margin:0 0 14px;">
                        <p style="margin:0; font:400 12px/1.6 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; color:#6b7280;">
                            {if:siteName}&copy; {var:year} {var:siteName escape}{endif}
                            {if:unsubscribeUrl}
                                <br>{t:`mail.footer.subscription_notice`:`mail` raw unsubscribe_href=unsubscribeUrl}
                            {endif}
                        </p>
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>
</body>
</html>
